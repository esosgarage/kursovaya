'''
/* Файл реализует функции меню, ввод данных пользователем
* и вывод результатов расчетов в консоль
*/

#include <stdio.h>
#include <math.h>
#include "ui_handlers.h"
#include "math_proc.h"

void ui_calc_value() {
	double x, res;
	int ok;

	printf("Введите x: ");
	if (scanf("%lf", &x) != 1) return;

	res = calc_func(x, &ok);
	if (ok) {
		printf("f(%.5lf) = %.5lf\n", x, res);
	}
	else {
		printf("Ошибка: точка вне области определения.\n");
	}
}

void ui_build_table() {
	double start, step, x, fx;
	int count, i, ok;

	printf("Начало, шаг, количество: ");
	if (scanf("%lf %lf %d", &start, &step, &count) != 3) return;

	printf("| %-10s | %-20s |\n", "x", "f(x)");
	printf("|------------|----------------------|\n");

	for (i = 0; i < count; i++) {
		x = start + i * step;
		fx = calc_func(x, &ok);
		if (ok) {
			printf("| %10.3lf | %20.3lf |\n", x, fx);
		}
		else {
			printf("| %10.3lf | %20s |\n", x, "error");
		}
	}
}
void ui_find_extrema() {
	double a, b, step, x, fx, min, max;
	int ok, first = 1;

	printf("Границы отрезка (a b) и шаг: ");
	if (scanf("%lf %lf %lf", &a, &b, &step) != 3) return;

	for (x = a; x <= b; x += step) {
		fx = calc_func(x, &ok);
		if (!ok) continue;

		if (first) {
			min = max = fx;
			first = 0;
		}
		else {
			if (fx < min) min =
				fx;
			if (fx > max) max = fx;
		}
	}

	if (!first) {
		printf("Min: %.5lf, Max: %.5lf\n", min, max);
	}
}

void ui_find_x_by_y() {
	double target_y, eps, x, fx;
	int ok;

	printf("Введите Y и точность (eps): ");
	if (scanf("%lf %lf", &target_y, &eps) != 2) return;

	/* сканирование диапазона [-10; 10] */
	for (x = -10.0; x <= 10.0; x += eps) {
		fx = calc_func(x, &ok);
		if (ok && fabs(fx - target_y) < eps) {
			printf("Найдено x = %.5lf\n", x);
			return;
		}
	}
	printf("Значение не найдено на интервале [-10, 10].\n");
}

void ui_derivative() {
	double x, h, f1, f2;
	int ok1, ok2;

	printf("Введите x и приращение h: ");
	if (scanf("%lf %lf", &x, &h) != 2) return;

	f1 = calc_func(x, &ok1);
	f2 = calc_func(x + h, &ok2);

	if (ok1 && ok2) {
		printf("f'(x) = %.5lf\n", (f2 - f1) / h);
	}
	else {
		printf("Ошибка расчета производной.\n");
	}
}
